# Copy this file to .env and fill in real values. Never commit .env.
#
# Site URL: prefer app/collections_apps/config/paths.php (APP_URL there wins).
# This .env value is only used when that file is left empty.

APP_URL=http://localhost/Pentagon-collections/public
APP_NAME="Pentagon Collections"
APP_DEBUG=1

# --- Database (AMPPS MySQL default: root / no password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pentagon_collections
DB_USER=root
DB_PASS=mysql

# --- SMTP (used for OTP login codes & password reset emails) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=changeme
MAIL_FROM_ADDRESS=concierge@pentagoncollections.com
MAIL_FROM_NAME="Pentagon Collections"

# --- Admin seed account (only used the first time the DB is set up) ---
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password
